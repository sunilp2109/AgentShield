# AgentShield local development
# Copy to .env and adjust as needed.

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
BACKEND_PORT=8000
APP_ENV=development
SHIELD_ENABLED=true

# LLM provider is independent. Set the active provider name and its key.
# Supported names will be registered in backend/app/llm/factory.py
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# SQLite
DATABASE_URL=sqlite:///./data/agentshield.db

# Controlled mock filesystem root (never escape this path)
SANDBOX_FS_ROOT=./mock_data/files

# Human-in-the-loop approval expiry
APPROVAL_TTL_MINUTES=15
