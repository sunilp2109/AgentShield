APP_ENV=development
SHIELD_ENABLED=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# LLM provider: mock | groq | openai | openrouter
# Real providers use OpenAI-compatible HTTP. Put the key in backend/.env only (gitignored).
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

DATABASE_URL=sqlite:///./data/agentshield.db
SANDBOX_FS_ROOT=./mock_data/files
